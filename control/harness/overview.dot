// System overview for the Fichet safe robot wiring — see control/wiring.md.
// Render: dot -Tsvg control/harness/overview.dot -o control/harness/overview.svg
// Project revision 2026-10-08.2: all four drivers on the RAMPS (key in E0); UART pigtail replaces the hub board.
digraph overview {
  graph [rankdir=LR, fontname="Helvetica", fontsize=11, nodesep=0.35, ranksep=0.7, label="Fichet safe robot — wiring overview (control/wiring.md, revision 2026-10-08.2)", labelloc=t];
  node  [shape=box, style="rounded", fontname="Helvetica", fontsize=10];
  edge  [fontname="Helvetica", fontsize=9];

  psu  [label="12 V / 5 A PSU\n(ledmo)"];
  usb  [label="Computer\nUSB serial log\n(logger.py)"];

  subgraph cluster_dial {
    label="Dial unit — all the electronics"; style=dashed; fontsize=10;
    uart [label="UART pigtail\n6 leads, one splice:\n1 kΩ in the TX2 lead,\nRX2 + all 4 PDN on the splice"];
    subgraph cluster_ramps {
      label="Mega 2560 + RAMPS 1.4  (5 A fuse feeds all 4 drivers)"; style=solid; fontsize=10;
      mega [label="Mega 2560\nTX2 D16 / RX2 D17 (AUX-4 18/17)\nbutton D14 (Y_MIN)"];
      x    [label="X socket: TMC2209 addr 0\nDial A (top-left)\nSTEP 54 DIR 55 EN 38\nDIAG → X_MIN D3"];
      y    [label="Y socket: TMC2209 addr 1 (MS1)\nDial B (top-right)\nSTEP 60 DIR 61 EN 56\nDIAG → X_MAX D2"];
      z    [label="Z socket: TMC2209 addr 2 (MS2)\nDial C (bottom)\nSTEP 46 DIR 48 EN 62\nDIAG → Z_MIN D18"];
      e0   [label="E0 socket: TMC2209 addr 3 (MS1+MS2)\nKey\nSTEP 26 DIR 28 EN 24\nDIAG → Z_MAX D19"];
    }
    ma [label="Motor A\n17HE19-2004S", shape=ellipse];
    mb [label="Motor B", shape=ellipse];
    mc [label="Motor C", shape=ellipse];
  }

  subgraph cluster_key {
    label="Key turner"; style=dashed; fontsize=10;
    mk  [label="Key motor\n17HE19-2004S\nits own ~1 m cable", shape=ellipse];
  }

  psu -> mega [label="12 V → RAMPS '5A' input\n(F1 5 A → every VMOT, incl. E0)"];
  usb -> mega [dir=both, label="USB"];
  mega -> x [arrowhead=none]; mega -> y [arrowhead=none]; mega -> z [arrowhead=none]; mega -> e0 [arrowhead=none];
  x -> ma; y -> mb; z -> mc;
  e0 -> mk [penwidth=2, label="key motor cable, ~1 m\n(the only wire between the units)"];
  uart -> x [dir=both, style=dashed, label="UART (MS3 jumper pin)"];
  uart -> y [dir=both, style=dashed];
  uart -> z [dir=both, style=dashed];
  uart -> e0 [dir=both, style=dashed];
  mega -> uart [dir=both, label="TX2 / RX2 (AUX-4)"];
}
